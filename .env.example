# Application Secret & Debug
SECRET_KEY=change-me-to-a-very-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://erp_user:erp_secure_password_2026@localhost:5432/erp_db

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# SimpleJWT Authentication
JWT_SECRET=change-me-to-a-secure-jwt-signing-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Company Information Defaults
COMPANY_NAME="AromaCraft Fragrances & Incense Pvt Ltd"
COMPANY_GSTIN="29AABCA1234F1Z5"
